# Скопируйте в .env (локально) или задайте в Railway → Variables (продакшн)

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (обязательно) ---
ANTHROPIC_API_KEY=
# Модель по умолчанию для новых ботов: claude-haiku-5-5 (рекомендуем) или claude-sonnet-5-5
DEFAULT_AI_MODEL=claude-haiku-5-5

# --- OpenAI (необязательно) — только расшифровка голосовых сообщений клиентов ---
OPENAI_API_KEY=

# --- Telegram ---
# Бот-канал для клиентов (если клиенты пишут боту в Telegram)
TELEGRAM_BOT_TOKEN=
# ID бота из таблицы bots, которому идут сообщения Telegram-канала
TELEGRAM_BOT_ID=
# Бот для уведомлений сотрудникам (горячие клиенты, напоминания). Если пусто — используется TELEGRAM_BOT_TOKEN
TELEGRAM_NOTIFY_BOT_TOKEN=

# --- Wazzup ---
# API-ключ Wazzup вводится в панели (Настройки → Wazzup), здесь только адрес API
WAZZUP_API_URL=https://api.wazzup24.com/v3

# --- Поведение бота ---
# Сколько секунд ждать следующих сообщений клиента перед ответом
REPLY_DEBOUNCE_SECONDS=6
TIMEZONE=Asia/Almaty

# --- Приложение ---
APP_ENV=production
APP_SECRET_KEY=
# Публичный адрес сервиса (на него Wazzup шлёт вебхуки, из него строятся ссылки в уведомлениях)
BACKEND_URL=https://aisalesmanager-production.up.railway.app
FRONTEND_URL=https://aisalesmanager-production.up.railway.app
